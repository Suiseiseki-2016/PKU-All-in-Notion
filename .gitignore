.env
# no trailing slash: the venv may be a symlink to storage outside an
# iCloud-synced folder (see docs/USER_GUIDE.md §7)
.venv
.venv-windows-test/
__pycache__/
*.pyc
.pytest_cache/
.pytest-*/
.ruff_cache/
.probe/

# synced course material and derived artifacts
data/
logs/
attachments/
outputs/
tmp/
# Windows reserved-name artifact from a faulty redirect
NUL
*.mp4
*.ts

# packaging build output (uv build -> dist\; see installer/windows/README.md)
dist/
# release wheels staged into the public-index upload tree are build
# artifacts; only the generated index.html + SHA256SUMS.txt are committed
# (see installer/release/RUNBOOK.md)
installer/release/site/wheels/*.whl
