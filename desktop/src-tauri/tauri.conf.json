{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PKU All in Notion",
  "version": "0.1.21",
  "identifier": "info.aeoluswu.pku-all-in-notion",
  "build": {
    "frontendDist": "../src",
    "beforeDevCommand": "npm run stage-sidecar:dev",
    "beforeBuildCommand": "npm run stage-sidecar"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "PKU All in Notion",
        "width": 1100,
        "height": 760,
        "minWidth": 800,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/runtime": "resources/runtime"
    },
    "externalBin": [
      "binaries/pku-sync"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "template": "nsis/installer.nsi"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    },
    "createUpdaterArtifacts": true,
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-",
      "dmg": {
        "windowSize": { "width": 660, "height": 400 },
        "appPosition": { "x": 180, "y": 220 },
        "applicationFolderPosition": { "x": 480, "y": 220 }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJGMUY2OTBENUZERDgzMjMKUldRamc5MWZEV2tmTHhEUWIxWm9rVkhxalFLUTYxYmRNTkRjWFdkNE9tZXZ2amI3Lys2QWpPUHcK",
      "endpoints": [
        "https://pku.aeoluswu.info/updates/{{target}}/{{arch}}/{{current_version}}"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
