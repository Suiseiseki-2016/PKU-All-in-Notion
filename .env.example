# 首次使用推荐直接跑 `pku-sync setup`：向导会自动写入 PKU 账号、OPENAI_API_KEY、
# AGENT_HOST，并为你选的 agent 宿主（Factory/Claude/Codex）注册 pku-sync 与官方
# Notion MCP。Notion 授权由宿主管理：浏览器里点一次「允许」，凭证存宿主自己的
# keyring，不进 .env。本文件是全部可选项的参考，并非必填清单。

# PKU IAAA credentials (student ID and password)
PKU_USERNAME=2300012345
PKU_PASSWORD=your_password

# Where synced material is written (absolute path recommended on Windows)
DATA_DIR=data

# Optional: restrict sync to specific Blackboard course IDs (comma separated)
# COURSE_ALLOWLIST=_104128_1,_101545_1

# Optional: skip specific course IDs
# COURSE_DENYLIST=

# Optional: pin the 5-digit term prefix of course codes (26271 = 2026-27 term 1).
# Empty auto-detects the newest term in the account.
# COURSE_TERM=
# INCLUDE_PAST_TERMS=false

# Optional LLM used by the `notes` stage (OpenAI-compatible)
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=
NOTES_MODEL=qwen/qwen3.5-397b-a17b

# One-shot LLM backend for the daily summary (and later the batch pages).
# auto = OpenAI-compatible API when OPENAI_API_KEY is set, else a logged-in
# agent CLI as a plain text backend (claude, codex, droid - in that order).
# LLM_PROVIDER=auto
# LLM_MODEL=            # empty = provider default; openai falls back to NOTES_MODEL
# LLM_TIMEOUT=600

# 每日自动运行由你选择的系统调度器负责（任务计划程序 / launchd / cron 等），
# 定时跑 `pku-sync automate` 即可；本项目本身不注册调度。

# Agent host that owns the Notion MCP OAuth session and runs the review step:
# claude (claude code, default) | codex | factory (droid).
# `pku-sync mcp configure <host>` registers the pku-sync + official notion
# MCP servers for that host.
# AGENT_HOST=claude

# Notion 接入的默认路径是官方 MCP（https://mcp.notion.com/mcp）：
# `pku-sync setup` / `pku-sync mcp configure <host>` 为所选宿主注册 notion MCP，
# 浏览器 OAuth 一次确认后凭证存宿主自己的 keyring——不进 .env，用户零配置。
#
# 以下三项仅是无 agent 宿主环境的 REST fallback（高级用户可选）：
# 1) https://www.notion.com/profile/integrations 新建内部集成
# 2) 在 Class Notes hub 页面右上 …菜单 → Connections 里添加该集成（子页与数据库随之可达）
# 3) 把 Secrets 页的 Internal Integration Secret 填到这里
# NOTION_TOKEN=
# 或自建 public integration 后跑 `pku-sync notion login`（浏览器 OAuth）自动
# 写入 NOTION_TOKEN：授权码经平台 relay 交换——本地只需公开的
# NOTION_OAUTH_CLIENT_ID，client secret 由服务端持有、不进 .env。回调端口在
# 8765/8766 里自动选择，集成需同时登记两个 redirect URI
# （http://localhost:8765/callback 与 http://localhost:8766/callback）：
# NOTION_OAUTH_CLIENT_ID=
# （NOTION_OAUTH_CLIENT_SECRET 仅遗留的自托管 REST fallback 需要，本登录流程不用。）

# Whisper model for the transcribe stage: tiny/base/small/medium/large-v3
WHISPER_MODEL=small
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16

# Transcription backend: local (faster-whisper, default) or cloud -- the M2
# wrapper service (docs/SERVICE_PLAN.md §3.3): audio uploads to OUR relay only,
# never to a third-party API; the relay meters minutes per platform account and
# holds the upstream ASR key. Users never see any key (§1.7): PLATFORM_TOKEN is
# the account session the app writes automatically at activation.
TRANSCRIPTION_BACKEND=local
# CLOUD_TRANSCRIBE_URL=https://pku.aeoluswu.info/v1/transcribe
# PLATFORM_TOKEN=

# Window-scoped organizer E2E only; leave false for normal production use.
# EXERCISE_E2E_ENABLED=false

# Delete the downloaded mp4 after transcription + keyframes succeed
DELETE_VIDEO_AFTER_PROCESSING=true
